{
  "name": "dsh-miliastra",
  "version": "0.3.0",
  "description": "原神·千星奇域（Miliastra Wonderland）UGC 工具链：活文件定位与部署、地图存档 .gil 读取、运行时日志 .gia 取证、画面截图、探针模板化，外加一个侧边栏状态面板。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "assets/*",
    ".github/release-notes/*",
    "docs/**/*.md",
    "engine/**/*.js",
    "engine/**/*.mjs",
    "engine/**/*.md",
    "index.js",
    "lib/**/*.js",
    "lib/**/*.mjs",
    "lib/**/*.html",
    "lib/**/*.ps1",
    "lib/assets/*",
    "cordis.patch.yml",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.1.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "genshin",
    "miliastra",
    "ugc"
  ],
  "license": "GPL-3.0-only",
  "dependencies": {
    "@napi-rs/canvas": "0.1.100",
    "fengari": "0.1.5",
    "pixi.js": "8.20.0",
    "protobufjs": "8.7.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "esbuild": "0.25.12",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LoktLin/dsh-miliastra.git"
  },
  "bugs": {
    "url": "https://github.com/LoktLin/dsh-miliastra/issues"
  },
  "homepage": "https://github.com/LoktLin/dsh-miliastra#readme",
  "author": "linyq",
  "contributors": [
    {
      "name": "LoktLin",
      "url": "https://github.com/LoktLin"
    }
  ],
  "scripts": {
    "lint": "node tools/lint.mjs",
    "typecheck": "node tools/typecheck.mjs",
    "test": "node tools/test-all.mjs",
    "test:engine": "node --test \"engine/**/*.test.mjs\"",
    "build:sim-play": "node tools/build-sim-play.mjs",
    "prepublishOnly": "node tools/build-sim-play.mjs --check && npm test"
  },
  "publishConfig": {
    "access": "public"
  }
}
